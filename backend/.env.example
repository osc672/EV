# ------------------------------------------------------------------
# EV Rescue — Backend environment
# Copy to .env and fill in real values. NEVER commit real secrets.
# ------------------------------------------------------------------

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,exp://127.0.0.1:19000

# PostgreSQL + PostGIS
DATABASE_URL=postgresql://evrescue:evrescue@localhost:5432/evrescue?schema=public

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# OTP
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_DEBUG_RETURN_CODE=true

# SMS provider (e.g. Twilio / MSG91 / Fast2SMS)
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=EVRSQ

# Maps (Google / Mapbox)
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Object storage (S3 compatible: MinIO / AWS S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ev-rescue
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/ev-rescue

# Firebase Cloud Messaging (optional)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Razorpay (optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI vision screening (optional)
AI_VISION_API_URL=
AI_VISION_API_KEY=

# Redis (optional — rate limit / OTP cache)
REDIS_URL=

# Admin bootstrap
ADMIN_EMAIL=admin@evrescue.local
ADMIN_PHONE=+919999999999
ADMIN_PASSWORD=Admin@12345
