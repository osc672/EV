{
  "expo": {
    "name": "EV Rescue",
    "slug": "ev-rescue",
    "scheme": "evrescue",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#021B14",
    "primaryColor": "#10B981",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.evrescue.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "EV Rescue uses your location to find verified charging points near you."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.evrescue.app",
      "adaptiveIcon": {
        "backgroundColor": "#021B14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "EV Rescue uses your location to find verified charging points near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "EV Rescue needs photo access so providers can upload verification documents."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B3D2E"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#021B14"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "newArchEnabled": false,
            "extraProguardRules": "-keep class com.google.android.gms.maps.** { *; }\n-keep interface com.google.android.gms.maps.** { *; }\n-keep class com.rnmaps.maps.** { *; }\n-keep class com.airbnb.android.react.maps.** { *; }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://ev-production-760f.up.railway.app/api/v1",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "01f3dc91-ac92-44ac-901e-dc80476145fd"
      }
    },
    "owner": "saivone"
  }
}
